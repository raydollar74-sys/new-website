# See https://help.github.com/articles/ignoring-files/ for more about using .gitignore.

# dependencies
/node_modules
/.pnp
.pnp.js

# next.js build output (regenerated by `next dev` / `next build`)
/.next/
/out/

# OpenNext + Cloudflare Workers build output (regenerated by `npm run deploy` / `npm run preview`)
/.open-next/
/.wrangler/
.dev.vars
.dev.vars.*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (keep secrets out of git)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo
